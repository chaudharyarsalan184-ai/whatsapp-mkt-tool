# Server
PORT=5000
NODE_ENV=development

# Database — Turso cloud (libsql://...) requires TURSO_AUTH_TOKEN.
# For local dev without Turso: TURSO_DATABASE_URL=file:./data/local.db (omit or ignore token)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Redis — BullMQ queue for campaigns. Use Docker: docker run -d -p 6379:6379 --name redis-wa redis:alpine
# Set to disable to run API without Redis (campaign send queue off): REDIS_URL=disable
REDIS_URL=redis://localhost:6379

# JWT — use a long random string in production (32+ characters)
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Meta WhatsApp Cloud API (developers.facebook.com)
META_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_TOKEN=your-permanent-access-token
META_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-string
META_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
META_API_VERSION=v19.0

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
